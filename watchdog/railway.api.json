{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile.multistage",
    "watchPatterns": ["apps/api/**", "packages/**", "package.json", "bun.lock", "watchdog/railway.api.json"]
  },
  "deploy": {
    "preDeployCommand": ["cd packages/db && node ../../node_modules/prisma/build/index.js migrate deploy"],
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
