{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "watchdog/Dockerfile.portal",
    "watchPatterns": ["apps/portal/**", "packages/**", "package.json", "bun.lock", "watchdog/Dockerfile.portal", "watchdog/railway.portal.json"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
