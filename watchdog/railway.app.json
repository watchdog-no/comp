{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "watchdog/Dockerfile.app",
    "watchPatterns": ["apps/app/**", "packages/**", "package.json", "bun.lock", "watchdog/Dockerfile.app", "watchdog/railway.app.json"]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
